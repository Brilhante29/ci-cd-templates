{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortfolioProjectManifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "program",
    "status",
    "claim",
    "stack",
    "language_profile",
    "decision_brain",
    "architecture",
    "design_system",
    "benchmark",
    "release"
  ],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "manifest_version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Absent or 1 uses legacy compatibility; 2 enables current governance gates."
    },
    "program": {
      "type": "object",
      "required": ["id", "narrative_fit"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "ai-evaluation-retrieval",
            "applied-computer-vision",
            "backend-reliability-platform",
            "mlops-data-platform",
            "delivery-observability-infra",
            "portfolio-evidence-platform"
          ]
        },
        "narrative_fit": { "type": "string", "minLength": 20 },
        "shared_assets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "string",
      "enum": ["scaffold", "implemented", "benchmarked", "published"]
    },
    "claim": { "type": "string", "minLength": 10 },
    "stack": {
      "type": "array",
      "items": { "type": "string" }
    },
    "language_profile": {
      "type": "object",
      "required": ["primary", "reason"],
      "properties": {
        "primary": {
          "type": "string",
          "enum": [
            "python",
            "java",
            "kotlin",
            "go",
            "typescript",
            "angular",
            "nextjs",
            "terraform",
            "kotlin-jvm",
            "java-spring-backend",
            "spring-kotlin-backend",
            "fastapi-backend",
            "go-backend",
            "node-typescript-backend"
          ]
        },
        "secondary": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 10 }
      }
    },
    "jvm": {
      "type": "object",
      "required": [
        "language",
        "framework",
        "build",
        "toolchain_version",
        "gradle_wrapper_version",
        "wrapper_distribution_sha256",
        "interoperability_boundary",
        "benchmark_effect",
        "rejected_alternatives"
      ],
      "properties": {
        "language": { "type": "string", "enum": ["java", "kotlin", "mixed"] },
        "framework": { "type": "string", "enum": ["none", "spring"] },
        "build": { "const": "gradle-kotlin-dsl" },
        "toolchain_version": { "type": "integer", "minimum": 17, "maximum": 25 },
        "gradle_wrapper_version": {
          "type": "string",
          "enum": ["8.10.2", "8.12", "9.3.0"]
        },
        "wrapper_distribution_sha256": {
          "type": "string",
          "enum": [
            "31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26",
            "7a00d51fb93147819aab76024feece20b6b84e420694101f276be952e08bef03",
            "0d585f69da091fc5b2beced877feab55a3064d43b8a1d46aeb07996b0915e0e0"
          ]
        },
        "interoperability_boundary": { "type": "string", "minLength": 10 },
        "benchmark_effect": { "type": "string", "minLength": 10 },
        "rejected_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["option", "reason"],
            "properties": {
              "option": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 10 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "gradle_wrapper_version": { "const": "8.10.2" } },
            "required": ["gradle_wrapper_version"]
          },
          "then": {
            "properties": {
              "wrapper_distribution_sha256": {
                "const": "31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "gradle_wrapper_version": { "const": "8.12" } },
            "required": ["gradle_wrapper_version"]
          },
          "then": {
            "properties": {
              "wrapper_distribution_sha256": {
                "const": "7a00d51fb93147819aab76024feece20b6b84e420694101f276be952e08bef03"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "gradle_wrapper_version": { "const": "9.3.0" } },
            "required": ["gradle_wrapper_version"]
          },
          "then": {
            "properties": {
              "wrapper_distribution_sha256": {
                "const": "0d585f69da091fc5b2beced877feab55a3064d43b8a1d46aeb07996b0915e0e0"
              }
            }
          }
        }
      ]
    },
    "messaging_decision": {
      "type": "object",
      "required": [
        "selected_messaging_mode",
        "reason",
        "delivery_guarantee",
        "ordering_need",
        "replay_need",
        "retry_dlq_strategy",
        "rejected_alternatives"
      ],
      "properties": {
        "selected_messaging_mode": {
          "type": "string",
          "enum": ["none", "outbox-only", "rabbitmq", "kafka", "redis-streams", "nats"]
        },
        "reason": { "type": "string", "minLength": 10 },
        "delivery_guarantee": { "type": "string", "minLength": 3 },
        "ordering_need": { "type": "string", "minLength": 3 },
        "replay_need": { "type": "string", "minLength": 3 },
        "retry_dlq_strategy": { "type": "string", "minLength": 3 },
        "rejected_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["option", "reason"],
            "properties": {
              "option": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 10 }
            }
          }
        },
        "kafka_streams": {
          "type": "object",
          "required": [
            "processing_mode",
            "input_topics",
            "output_topics",
            "key_strategy",
            "repartition_strategy",
            "serde_contract",
            "topology",
            "stream_table_join_semantics",
            "window_and_grace_policy",
            "state_stores",
            "changelog_policy",
            "processing_guarantee",
            "invalid_record_strategy",
            "restoration_strategy",
            "rebalance_plan",
            "evidence_plan",
            "benchmark_modes"
          ],
          "properties": {
            "processing_mode": {
              "type": "string",
              "enum": ["simple-consumer", "kafka-streams"]
            },
            "input_topics": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "output_topics": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "key_strategy": { "type": "string", "minLength": 5 },
            "repartition_strategy": { "type": "string", "minLength": 5 },
            "serde_contract": { "type": "string", "minLength": 5 },
            "topology": { "type": "string", "minLength": 10 },
            "stream_table_join_semantics": { "type": "string", "minLength": 10 },
            "window_and_grace_policy": { "type": "string", "minLength": 10 },
            "state_stores": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "changelog_policy": { "type": "string", "minLength": 10 },
            "processing_guarantee": { "type": "string", "minLength": 5 },
            "invalid_record_strategy": { "type": "string", "minLength": 5 },
            "restoration_strategy": { "type": "string", "minLength": 5 },
            "rebalance_plan": { "type": "string", "minLength": 10 },
            "evidence_plan": { "type": "string", "minLength": 10 },
            "benchmark_modes": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["topology-test-driver", "real-broker"]
              },
              "contains": { "const": "topology-test-driver" }
            }
          }
        }
      }
    },
    "decision_brain": {
      "type": "object",
      "required": [
        "principles",
        "stack_profile",
        "api_style",
        "messaging",
        "cloud",
        "database",
        "library_policy",
        "record_path"
      ],
      "properties": {
        "principles": {
          "type": "object",
          "required": ["coupling_rule", "solid", "simplicity_rule", "testability_rule"],
          "properties": {
            "coupling_rule": { "type": "string", "minLength": 10 },
            "solid": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["srp", "ocp", "lsp", "isp", "dip"]
              },
              "minItems": 1
            },
            "simplicity_rule": { "type": "string", "minLength": 10 },
            "testability_rule": { "type": "string", "minLength": 10 },
            "rejected_overengineering": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "stack_profile": {
          "type": "string",
          "enum": [
            "kotlin-jvm",
            "kafka-streams",
            "spring-kotlin-backend",
            "java-spring-backend",
            "fastapi-backend",
            "go-backend",
            "angular",
            "nextjs",
            "python",
            "python-ml",
            "terraform",
            "node-typescript-backend"
          ]
        },
        "api_style": {
          "type": "string",
          "enum": ["rest-http", "graphql", "grpc", "websocket", "sse", "cli"]
        },
        "messaging": {
          "type": "string",
          "enum": ["none", "outbox-only", "rabbitmq", "kafka", "redis-streams", "nats"]
        },
        "cloud": {
          "type": "object",
          "required": [
            "mode",
            "local_provider",
            "real_provider_target",
            "adapter_rule",
            "config_switch"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["none", "kumo-local-first", "adapter-fake", "real-cloud-required"]
            },
            "local_provider": { "type": "string" },
            "real_provider_target": { "type": "string" },
            "emulated_services": { "type": "array", "items": { "type": "string" } },
            "adapter_rule": { "type": "string", "minLength": 10 },
            "config_switch": { "type": "string", "minLength": 4 },
            "unsupported_behaviors": { "type": "array", "items": { "type": "string" } }
          }
        },
        "database": { "type": "string" },
        "runtime": { "type": "string" },
        "library_policy": { "type": "string", "minLength": 10 },
        "record_path": { "type": "string" },
        "rejected_options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option", "reason"],
            "properties": {
              "option": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "style",
        "reason",
        "dependency_rule",
        "boundaries",
        "rejected_alternatives"
      ],
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "mvc",
            "layered",
            "modular-monolith",
            "clean-architecture",
            "hexagonal",
            "cqrs-event-sourcing",
            "event-driven",
            "mvvm",
            "pipeline",
            "serverless",
            "microservices"
          ]
        },
        "reason": { "type": "string", "minLength": 20 },
        "problem_forces": {
          "type": "object",
          "properties": {
            "domain_complexity": { "type": "string", "enum": ["low", "medium", "high"] },
            "integration_pressure": { "type": "string", "enum": ["low", "medium", "high"] },
            "ui_state_complexity": { "type": "string", "enum": ["none", "low", "medium", "high"] },
            "data_or_ml_reproducibility": { "type": "string", "enum": ["low", "medium", "high"] },
            "auditability": { "type": "string", "enum": ["low", "medium", "high"] },
            "throughput_or_async": { "type": "string", "enum": ["low", "medium", "high"] },
            "independent_deployability": { "type": "string", "enum": ["low", "medium", "high"] }
          }
        },
        "dependency_rule": { "type": "string", "minLength": 10 },
        "boundaries": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["style", "reason"],
            "properties": {
              "style": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "design_system": {
      "type": "object",
      "required": ["tokens", "readme_components"],
      "properties": {
        "tokens": { "type": "string" },
        "readme_components": { "type": "array", "items": { "type": "string" } },
        "diagram_required": { "type": "boolean" }
      }
    },
    "reuse": { "type": "object" },
    "benchmark": {
      "type": "object",
      "required": ["primary_metric", "unit", "command", "result_path"],
      "properties": {
        "primary_metric": { "type": "string" },
        "unit": { "type": "string" },
        "command": { "type": "string" },
        "result_path": { "type": "string" },
        "publication_result_path": { "type": "string" },
        "evidence_status": {
          "type": "string",
          "enum": ["pending", "stale", "current"]
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "docker",
        "no_secret_default_path",
        "readme_has_number",
        "references_documented"
      ],
      "properties": {
        "docker": { "type": "string" },
        "no_secret_default_path": { "type": "boolean" },
        "readme_has_number": { "type": "boolean" },
        "references_documented": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "manifest_version": { "const": 2 } },
        "required": ["manifest_version"]
      },
      "then": {
        "properties": {
          "stack": {
            "minItems": 1,
            "uniqueItems": true
          },
          "decision_brain": {
            "properties": {
              "principles": {
                "properties": {
                  "solid": {
                    "minItems": 5,
                    "uniqueItems": true
                  }
                }
              },
              "cloud": {
                "allOf": [
                  {
                    "if": {
                      "properties": { "mode": { "const": "none" } },
                      "required": ["mode"]
                    },
                    "then": {
                      "properties": {
                        "local_provider": { "const": "none" },
                        "real_provider_target": { "const": "none" },
                        "emulated_services": { "maxItems": 0 }
                      }
                    }
                  }
                ]
              }
            }
          },
          "architecture": {
            "required": ["problem_forces"],
            "properties": {
              "problem_forces": {
                "required": [
                  "domain_complexity",
                  "integration_pressure",
                  "ui_state_complexity",
                  "data_or_ml_reproducibility",
                  "auditability",
                  "throughput_or_async",
                  "independent_deployability"
                ]
              },
              "rejected_alternatives": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "manifest_version": { "const": 2 } },
            "required": ["manifest_version"]
          },
          {
            "anyOf": [
              {
                "properties": {
                  "language_profile": {
                    "properties": {
                      "primary": {
                        "enum": [
                          "java",
                          "kotlin",
                          "kotlin-jvm",
                          "java-spring-backend",
                          "spring-kotlin-backend"
                        ]
                      }
                    },
                    "required": ["primary"]
                  }
                },
                "required": ["language_profile"]
              },
              {
                "properties": {
                  "decision_brain": {
                    "properties": {
                      "stack_profile": {
                        "enum": ["kotlin-jvm", "java-spring-backend", "spring-kotlin-backend", "kafka-streams"]
                      }
                    },
                    "required": ["stack_profile"]
                  }
                },
                "required": ["decision_brain"]
              },
              {
                "properties": {
                  "stack": {
                    "contains": {
                      "enum": ["java", "java21", "kotlin", "jvm", "spring", "spring-boot", "kafka-streams"]
                    }
                  }
                },
                "required": ["stack"]
              }
            ]
          }
        ]
      },
      "then": { "required": ["jvm"] }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "manifest_version": { "const": 2 } },
            "required": ["manifest_version"]
          },
          {
            "properties": {
              "language_profile": {
                "properties": {
                  "primary": { "enum": ["java", "java-spring-backend"] }
                },
                "required": ["primary"]
              }
            },
            "required": ["language_profile"]
          }
        ]
      },
      "then": {
        "properties": {
          "jvm": {
            "properties": { "language": { "enum": ["java", "mixed"] } }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "manifest_version": { "const": 2 } },
            "required": ["manifest_version"]
          },
          {
            "properties": {
              "language_profile": {
                "properties": {
                  "primary": { "enum": ["kotlin", "kotlin-jvm", "spring-kotlin-backend"] }
                },
                "required": ["primary"]
              }
            },
            "required": ["language_profile"]
          }
        ]
      },
      "then": {
        "properties": {
          "jvm": {
            "properties": { "language": { "enum": ["kotlin", "mixed"] } }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "manifest_version": { "const": 2 } },
            "required": ["manifest_version"]
          },
          {
            "properties": {
              "decision_brain": {
                "properties": {
                  "stack_profile": { "enum": ["java-spring-backend", "spring-kotlin-backend"] }
                },
                "required": ["stack_profile"]
              }
            },
            "required": ["decision_brain"]
          }
        ]
      },
      "then": {
        "properties": {
          "jvm": {
            "properties": { "framework": { "const": "spring" } }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "manifest_version": { "const": 2 } },
            "required": ["manifest_version"]
          },
          {
            "anyOf": [
              {
                "properties": {
                  "decision_brain": {
                    "properties": { "messaging": { "const": "kafka" } },
                    "required": ["messaging"]
                  }
                },
                "required": ["decision_brain"]
              },
              {
                "properties": {
                  "decision_brain": {
                    "properties": { "stack_profile": { "const": "kafka-streams" } },
                    "required": ["stack_profile"]
                  }
                },
                "required": ["decision_brain"]
              },
              {
                "properties": {
                  "stack": {
                    "contains": { "enum": ["kafka", "kafka-streams"] }
                  }
                },
                "required": ["stack"]
              },
              {
                "properties": {
                  "messaging_decision": {
                    "properties": {
                      "selected_messaging_mode": { "const": "kafka" }
                    },
                    "required": ["selected_messaging_mode"]
                  }
                },
                "required": ["messaging_decision"]
              },
              {
                "properties": {
                  "messaging_decision": {
                    "required": ["kafka_streams"]
                  }
                },
                "required": ["messaging_decision"]
              }
            ]
          }
        ]
      },
      "then": {
        "required": ["messaging_decision"],
        "properties": {
          "decision_brain": {
            "properties": { "messaging": { "const": "kafka" } }
          },
          "messaging_decision": {
            "properties": { "selected_messaging_mode": { "const": "kafka" } }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "manifest_version": { "const": 2 } },
            "required": ["manifest_version"]
          },
          {
            "anyOf": [
              {
                "properties": {
                  "decision_brain": {
                    "properties": { "stack_profile": { "const": "kafka-streams" } },
                    "required": ["stack_profile"]
                  }
                },
                "required": ["decision_brain"]
              },
              {
                "properties": {
                  "stack": { "contains": { "const": "kafka-streams" } }
                },
                "required": ["stack"]
              },
              {
                "properties": {
                  "messaging_decision": {
                    "required": ["kafka_streams"]
                  }
                },
                "required": ["messaging_decision"]
              }
            ]
          }
        ]
      },
      "then": {
        "required": ["messaging_decision"],
        "properties": {
          "stack": { "contains": { "const": "kafka-streams" } },
          "decision_brain": {
            "properties": {
              "stack_profile": { "const": "kafka-streams" },
              "messaging": { "const": "kafka" }
            }
          },
          "messaging_decision": {
            "required": ["kafka_streams"],
            "properties": {
              "selected_messaging_mode": { "const": "kafka" },
              "kafka_streams": {
                "properties": {
                  "processing_mode": { "const": "kafka-streams" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "manifest_version": { "const": 2 } },
            "required": ["manifest_version"]
          },
          {
            "properties": {
              "status": { "enum": ["benchmarked", "published"] }
            },
            "required": ["status"]
          }
        ]
      },
      "then": {
        "properties": {
          "benchmark": {
            "required": ["evidence_status"],
            "properties": {
              "evidence_status": { "const": "current" }
            }
          }
        }
      }
    }
  ]
}
